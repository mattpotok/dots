! URxvt
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! Disable ISO mode bindings (Ctrl+Shift)
URxvt.iso14755: false
URxvt.iso14755_52: false

! Appearance
URxvt.scrollBar: false

! TokyoNight theme
URxvt.background: #1a1b26
URxvt.foreground: #c0caf5
URxvt.cursorColor: #c0caf5
URxvt.highlightColor: #33467c
URxvt.highlightTextColor: #c0caf5
URxvt*color0:  #15161e
URxvt*color1:  #f7768e
URxvt*color2:  #9ece6a
URxvt*color3:  #e0af68
URxvt*color4:  #7aa2f7
URxvt*color5:  #bb9af7
URxvt*color6:  #7dcfff
URxvt*color7:  #a9b1d6
URxvt*color8:  #414868
URxvt*color9:  #f7768e
URxvt*color10: #9ece6a
URxvt*color11: #e0af68
URxvt*color12: #7aa2f7
URxvt*color13: #bb9af7
URxvt*color14: #7dcfff
URxvt*color15: #c0caf5

URxvt.font: xft:DejaVu Sans Mono:pixelsize=14:antialias=true
URxvt.letterSpace: -1

! Copy, paste
URxvt.keysym.Shift-Control-V: eval:paste_clipboard
URxvt.keysym.Shift-Control-C: eval:selection_to_clipboard
URxvt.keysym.Control-Meta-c: builtin-string:
URxvt.keysym.Control-Meta-v: builtin-string:

! Scrolling options
URxvt.scrollTtyOutput: false
URxvt.scrollWithBuffer: true
URxvt.scrollTtyKeypress: true

