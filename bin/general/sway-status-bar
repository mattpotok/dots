#!/bin/sh
# Select the bar Sway launches; --toggle changes the selection and reloads Sway.
set -eu

state_directory="${XDG_STATE_HOME:-$HOME/.local/state}/dots"
mode_file="$state_directory/bar-mode"
mode=swaybar
if [ -r "$mode_file" ]; then
    mode=$(cat "$mode_file")
fi

if [ "${1:-}" = --toggle ]; then
    case "$mode" in
        waybar) mode=swaybar ;;
        *)
            command -v waybar >/dev/null || {
                printf 'sway-status-bar: install waybar first\n' >&2
                exit 1
            }
            mode=waybar
            ;;
    esac
    mkdir -p "$state_directory"
    printf '%s\n' "$mode" > "$mode_file"
    exec swaymsg reload
fi

if [ "$mode" = waybar ] && command -v waybar >/dev/null; then
    # Temporary popup-scrolling fix; see config/waybar/README.md.
    layer_shell_directory="$HOME/.local/opt/gtk-layer-shell-eb7876471dea/lib"
    if [ -r "$layer_shell_directory/libgtk-layer-shell.so.0" ]; then
        export LD_LIBRARY_PATH="$layer_shell_directory${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
    exec waybar "$@" --config "$HOME/.config/waybar/config.jsonc" \
        --style "$HOME/.config/waybar/style.css"
fi
exec swaybar "$@"
